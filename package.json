{
  "name": "terminus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted Terminus: your spheres, goals, habits and a personal agent — on your own machine.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "demo:welcome": "node demo/welcome/build.mjs",
    "demo:travel": "node demo/travel/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adhan": "^4.4.6",
    "hono": "^4.13.18",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "thinking-orbs": "^0.3.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@tanstack/react-query": "^5.107.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wouter": "^3.13.0"
  }
}
